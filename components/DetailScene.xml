<component name="DetailScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
        <field id="itemId" type="string" />
        <function name="LoadItem" />
        ' R6.3: When true, DetailScene auto-plays the item after loading instead
        ' of requiring the user to press the Play button. Used for deep-link
        ' cold-launch of movie/episode content.
        <field id="autoPlayOnLoad" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/DetailScene.brs" />
    <children>
        <!-- Background -->
        <Rectangle height="720" width="1280" color="#0d0d1a" />

        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Rectangle height="60" width="160" translation="[20,20]">
                <Button height="60" width="160" title="Back" id="backButton" />
            </Rectangle>
        </Rectangle>

        <!-- Content Area -->
        <Rectangle height="580" width="1280" translation="[0,100]">
            <!-- Poster -->
            <Rectangle height="400" width="280" translation="[40,40]">
            <Poster height="400" width="280" id="posterImage"
                     loadWidth="280" loadHeight="400" loadDisplayMode="scaleToFit"
                     failedUrl="pkg:/images/placeholder.png"
                     defaultUrl="pkg:/images/placeholder.png" />
            </Rectangle>

            <!-- Info Panel -->
            <Rectangle height="400" width="880" translation="[360,40]">
                <Label height="60" width="860" translation="[10,0]"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF"
                       id="titleLabel" />

                <Label height="40" width="860" translation="[10,70]"
                       font="font:MediumSystemFont"
                       color="#AAAAAA"
                       id="infoLabel" />

                <!-- P1-S8: Content Rating Badge (e.g., Rated PG-13) -->
                <Label height="35" width="200" translation="[10,105]"
                       font="font:MediumBoldSystemFont"
                       color="#FFD700"
                       id="contentRatingLabel" />

                <!-- Aggregate Rating Badge -->
                <RatingBadge height="50" width="160" translation="[700,62]"
                             id="ratingBadge" />

                <Rectangle height="200" width="860" translation="[10,120]">
                    <Label height="200" width="860"
                           font="font:SmallSystemFont"
                           color="#CCCCCC"
                           id="descriptionLabel"
                           wrap="true" />
                </Rectangle>

                <Button height="60" width="200" translation="[10,330]"
                        title="Play"
                        id="playButton" />

                <Button height="60" width="300" translation="[230,330]"
                        title="Add to Favorites"
                        visible="false"
                        id="favoriteButton" />

                <Button height="60" width="300" translation="[540,330]"
                        title="Rating: not set"
                        visible="false"
                        id="ratingButton" />

                <!-- R7.11: Add to Collection button -->
                <Button height="60" width="200" translation="[260,400]"
                        title="Add to Collection"
                        visible="false"
                        id="collectionButton" />

                <!-- R7.5: Mark Watched/Unwatched button -->
                <Button height="60" width="200" translation="[10,400]"
                        title="Mark as Watched"
                        visible="false"
                        id="watchedButton" />

                <!-- R7.5: Like button -->
                <Button height="60" width="200" translation="[220,400]"
                        title="Like"
                        visible="false"
                        id="likeButton" />
            </Rectangle>

            <!-- R7.4: Cast row - horizontal scrollable list of cast members -->
            <Row id="castRow" title="Cast" visible="false" translation="[0,460]" />

            <!-- R7.4: Extras row — bonus content like behind the scenes, interviews -->
            <Row id="extrasRow" title="Extras" visible="false" translation="[0,640]" />

            <!-- R7.4: Trailers row — trailers and promos -->
            <Row id="trailersRow" title="Trailers &amp; Promo" visible="false" translation="[0,820]" />

            <!-- R7.4: Crew row — director, writer, producer, etc. -->
            <Row id="crewRow" title="Crew" visible="false" translation="[0,1000]" />
        </Rectangle>

        <!-- Loading Indicator -->
        <Label id="loadingLabel" text="Loading..."
               translation="[640, 340]"
               horizAlign="center" color="#888888" />
    </children>
</component>
