<component name="RecommendationCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" />
    <field id="focusPercent" type="float" />
  </interface>
  <children>
    <Poster id="poster" width="140" height="210" />
    <Label id="titleLabel" width="140" maxLines="2"
           horizAlign="left" vertAlign="bottom"
           translation="[0,170]" />
    <Label id="yearLabel" width="140"
           horizAlign="left" translation="[0,190]" />
    <Label id="reasonBadge" text="Because You Watched"
           width="140" fontSize="10"
           horizAlign="left" translation="[0,205]" />
    <Label id="scoreLabel" width="140"
           horizAlign="right" translation="[0,205]" />
  </children>
  <script uri="pkg:/components/RecommendationCard.brs" />
</component>
