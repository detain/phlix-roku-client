<?xml version="1.0" encoding="utf-8"?>
<component name="LibraryAdminActionsScene" extends="Scene">
    <!-- LibraryAdminScene calls scene.LoadLibrary(...) across the component
         boundary, so the LoadLibrary interface fn MUST be declared (bsc does
         NOT catch a missing one - it is a runtime failure). Transitive closure:
         a component scope does NOT auto-include pkg:/source. -->
    <interface>
        <function name="LoadLibrary" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/LibraryAdminActionsScene.brs" />
    <children>
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="1200" translation="[40,20]"
                   text="Library"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />
        </Rectangle>
        <!-- Vertical action button column -->
        <LayoutGroup translation="[40,160]" itemSpacings="[20]">
            <Button width="420" height="64" title="Scan (incremental)" id="scanButton" />
            <Button width="420" height="64" title="Rescan (full)" id="rescanButton" />
            <Button width="420" height="64" title="Match Metadata" id="matchButton" />
            <Button width="420" height="64" title="Refresh Status" id="refreshButton" />
        </LayoutGroup>
        <!-- Current scan status -->
        <Label width="1200" height="200" translation="[500,160]"
               text=""
               wrap="true"
               font="font:MediumSystemFont"
               color="#FFFFFF"
               id="scanStatusLabel" />
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Loading status…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
