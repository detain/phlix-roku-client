<component name="LoginScene" extends="Scene">
    <interface>
        <field id="loginSucceeded" type="boolean" value="false" />
        <!-- F12b: fired (instead of loginSucceeded) when the post-login
             /me/servers probe finds a hub -> PhlixApp shows the ServerPicker. -->
        <field id="hubDetected" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AuthManager.brs" />
    <script type="text/brightscript" uri="pkg:/components/LoginScene.brs" />
    <children>
        <!-- Background -->
        <Rectangle height="720" width="1280" color="#0d0d1a" />

        <!-- Login Container -->
        <Rectangle height="500" width="500" translation="[390,110]" color="#1a1a2e">
            <!-- Title -->
            <Label height="60" width="460" translation="[20,20]"
                   text="Phlix"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   halign="center" />

            <!-- Username -->
            <Label height="30" width="460" translation="[20,90]"
                   text="Username"
                   font="font:SmallSystemFont"
                   color="#AAAAAA" />
            <TextEditBox height="50" width="460" translation="[20,120]"
                         hint="Username"
                         id="usernameInput" />

            <!-- Password -->
            <Label height="30" width="460" translation="[20,180]"
                   text="Password"
                   font="font:SmallSystemFont"
                   color="#AAAAAA" />
            <TextEditBox height="50" width="460" translation="[20,210]"
                         hint="Password"
                         secure="true"
                         id="passwordInput" />

            <!-- Error Label -->
            <Label height="30" width="460" translation="[20,270]"
                   text=""
                   font="font:SmallSystemFont"
                   color="#FF4444"
                   visible="false"
                   id="errorLabel" />

            <!-- Status Label -->
            <Label height="30" width="460" translation="[20,270]"
                   text=""
                   font="font:SmallSystemFont"
                   color="#0095d5"
                   visible="false"
                   id="statusLabel" />

            <!-- Login Button -->
            <Button height="60" width="460" translation="[20,310]"
                    title="Login"
                    id="loginButton" />
        </Rectangle>
    </children>
</component>