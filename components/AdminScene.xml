<component name="AdminScene" extends="Scene">
    <!-- HomeScene self-creates + appends + focuses this scene, so NO interface
         function is required. Transitive closure: a component scope does NOT
         auto-include pkg:/source. -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/AdminScene.brs" />
    <children>
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="800" translation="[40,20]"
                   text="Admin"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
        </Rectangle>
        <!-- Static admin menu (Dashboard now; future slices append rows) -->
        <LabelList height="500" width="1200" translation="[40,140]"
                   id="adminMenu" />
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Select an admin section"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
