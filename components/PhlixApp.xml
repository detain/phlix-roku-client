<component name="PhlixApp" extends="Scene">
    <interface>
        <field id="serverUrl" type="string" />
        ' Deep-link params from cold-launch: { contentId, mediaType, action }
        ' Set by main.brs when valid deep-link args are present in launch params.
        <field id="deepLinkParams" type="assocarray" />
        ' Exit signal (M-ROKU-01): set by OnKeyEvent when Back is pressed with an
        ' empty screen stack (we are on a bootstrap scene). Observed by main.brs on
        ' the screen message port; the loop then returns, ending the channel cleanly.
        ' There is no creatable roApp.Exit() primitive in Roku SceneGraph (absent from
        ' the official component library bsc ships), so main-thread exit-by-return is
        ' the platform-correct cure. Scripts must never fall through to RSG's native
        ' back handling: it closes only the FOCUSED scene, exposing the root's black
        ' boot chrome as a dead screen (review roku__casualgamer M2).
        <field id="exitChannel" type="boolean" alwaysNotify="true" />
    </interface>
    <!-- Shared source dependencies (SceneGraph components must explicitly script-include
         the pkg:/source files they use; source is not auto-global to component scopes). -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AuthManager.brs" />
    <!-- R7.5: SessionManager, LibraryManager, and TaskManager removed - unused -->
    <!-- R3.4: ToastManager for generalized toast/notification system -->
    <script type="text/brightscript" uri="pkg:/source/lib/ToastManager.brs" />
    <script type="text/brightscript" uri="pkg:/components/PhlixApp.brs" />
    <children>
        <!-- Boot loading state: shown immediately while auth check runs on ApiTask -->
        <Label id="bootLoadingLabel" text="Loading…" translation="[350,300]" />
        <!-- Boot error state: shown after 20s timeout with retry affordance -->
        <Group id="bootErrorGroup" visible="false">
            <Label id="bootErrorLabel" text="Can't reach the server" translation="[250,280]" />
            <Button id="bootRetryButton" text="Retry" translation="[350,340]" />
        </Group>
    </children>
</component>
