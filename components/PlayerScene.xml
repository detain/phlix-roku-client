<component name="PlayerScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
        <field id="itemId" type="string" />
        <field id="playbackInfo" type="assocarray" />
        <function name="Show" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <!-- F13 SyncPlay: PlayerScene reads SyncPlayProtocol() in BuildSyncPlayWsUrl
         (and may format status). The socket itself lives in SyncPlayTask. -->
    <script type="text/brightscript" uri="pkg:/source/lib/SyncPlayProtocol.brs" />
    <script type="text/brightscript" uri="pkg:/source/player/SleepTimer.brs" />
    <script type="text/brightscript" uri="pkg:/components/PlayerScene.brs" />

    <children>
        <!-- Video Player -->
        <Video height="720" width="1280" id="videoPlayer" />

        <!-- Overlay UI -->
        <Rectangle height="720" width="1280" transparency="0.7" visible="false" id="controlsOverlay">
            <!-- Top Bar -->
            <Rectangle height="100" width="1280" translation="[0,0]">
                <Rectangle height="100" width="200" translation="[20,20]">
                    <Button height="60" width="160" title="Back" id="backButton" />
                </Rectangle>
            </Rectangle>

            <!-- Title -->
            <Label height="60" width="900" translation="[200,30]"
                   font="font:MediumSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />

            <!-- Center Controls -->
            <HStack height="120" width="400" translation="[440,300]">
                <Button height="100" width="100" id="rewindButton" />
                <Button height="120" width="120" id="playPauseButton" />
                <Button height="100" width="100" id="forwardButton" />
            </HStack>

            <!-- Bottom Bar -->
            <Rectangle height="120" width="1280" translation="[0,580]">
                <Rectangle height="80" width="854" translation="[213,40]">
                    <Rectangle height="8" width="854" color="#404040" />
                    <Rectangle height="8" width="0" color="#0095d5" id="progressBar" />
                </Rectangle>
                <Label height="40" width="200" translation="[540,25]"
                       font="font:SmallSystemFont"
                       color="#FFFFFF"
                       id="timeLabel" />

                <!-- P3-S4: Sleep Timer countdown label -->
                <Label height="40" width="180" translation="[750,25]"
                       font="font:SmallSystemFont"
                       color="#0095d5"
                       visible="false"
                       id="sleepTimerLabel" />

                <!-- P3-S4: PiP (Picture-in-Picture) toggle button -->
                <Button height="50" width="100" translation="[940,15]"
                        title="PiP"
                        id="pipButton" />

                <!-- R2.5: Chapters button - opens chapter picker overlay -->
                <Button height="50" width="130" translation="[1060,15]"
                        title="Chapters"
                        id="chapterButton" />
            </Rectangle>

            <!-- P2-S5: Chapter label shown briefly when seeking to a chapter -->
            <Label height="50" width="600" translation="[340,260]"
                   font="font:MediumBoldSystemFont"
                   color="#FFFFFF"
                   horizAlign="center"
                   visible="false"
                   id="chapterLabel" />

            <!-- R6.9: Info label shown briefly when the info key is pressed -->
            <Label height="50" width="800" translation="[240,100]"
                   font="font:MediumBoldSystemFont"
                   color="#FFFFFF"
                   horizAlign="center"
                   visible="false"
                   id="infoLabel" />

                <!-- Skip Button Component - owns button and exposes skipRequested -->
            <SkipButton height="60" width="140" translation="[1120,640]" id="skipButton" />
        </Rectangle>

        <!-- ============================================================= -->
        <!-- F13 SyncPlay "Watch Together" overlay. Hidden by default; the   -->
        <!-- entire SyncPlay path is gated behind opening this panel (the    -->
        <!-- "*"/options key), so the default playback path is unchanged     -->
        <!-- when it is never shown.                                         -->
        <!-- ============================================================= -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.4" visible="false" id="syncPanel">
            <Rectangle height="640" width="600" translation="[40,40]" color="#0d0d1a">
                <Label height="50" width="540" translation="[30,20]"
                       text="Watch Together"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF" />
                <LabelList height="360" width="540" translation="[30,90]"
                           id="syncGroupList" />
                <Button height="60" width="260" translation="[30,470]"
                        title="Create Group" id="syncCreateButton" />
                <Button height="60" width="260" translation="[310,470]"
                        title="Leave" id="syncLeaveButton" />
                <Label height="80" width="540" translation="[30,550]"
                       wrap="true"
                       font="font:SmallSystemFont"
                       color="#AAAAAA"
                       id="syncStatusLabel" />
            </Rectangle>
        </Rectangle>

        <!-- ============================================================= -->
        <!-- G4 Quality picker overlay. Hidden by default; opened by the Up  -->
        <!-- key during playback. "Auto" = the multi-variant master playlist -->
        <!-- (native ABR); a pinned rung swaps to that variant's own HLS      -->
        <!-- media playlist. Inert until shown, so the default playback path  -->
        <!-- is byte-unchanged when the picker is never opened.               -->
        <!-- ============================================================= -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.4" visible="false" id="qualityPanel">
            <Rectangle height="560" width="520" translation="[720,80]" color="#0d0d1a">
                <Label height="50" width="460" translation="[30,20]"
                       text="Video Quality"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF" />
                <LabelList height="380" width="460" translation="[30,90]"
                           id="qualityList" />
                <Label height="70" width="460" translation="[30,480]"
                       wrap="true"
                       font="font:SmallSystemFont"
                       color="#AAAAAA"
                       id="qualityStatusLabel" />
            </Rectangle>
        </Rectangle>

        <!-- ============================================================= -->
        <!-- P3B-S7 Settings panel: Audio + Subtitle track selection.         -->
        <!-- Hidden by default; opened by the Down key during playback.      -->
        <!-- A row list presents "Audio" and "Subtitles" options; selecting   -->
        <!-- one opens the track list (or shows "Not available"). Additive:  -->
        <!-- when no tracks are present the panel still opens but shows the  -->
        <!-- empty-state message and returns gracefully.                     -->
        <!-- ============================================================= -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.4" visible="false" id="settingsPanel">
            <Rectangle height="480" width="520" translation="[720,120]" color="#0d0d1a">
                <Label height="50" width="460" translation="[30,20]"
                       text="Settings"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF" />
                <LabelList height="340" width="460" translation="[30,90]"
                           id="settingsList" />
                <Label height="70" width="460" translation="[30,400]"
                       wrap="true"
                       font="font:SmallSystemFont"
                       color="#AAAAAA"
                       id="settingsStatusLabel" />
            </Rectangle>
        </Rectangle>

        <!-- Track list sub-panel (Audio or Subtitles list). Lives inside     -->
        <!-- settingsPanel bounds; toggled visible when a track row is        -->
        <!-- selected from settingsList.                                    -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.4" visible="false" id="trackListPanel">
            <Rectangle height="520" width="520" translation="[720,100]" color="#0d0d1a">
                <Label height="50" width="460" translation="[30,20]"
                       text="Select Track"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF"
                       id="trackListTitle" />
                <LabelList height="380" width="460" translation="[30,90]"
                           id="trackList" />
                <Button height="60" width="200" translation="[30,440]"
                        title="Back"
                        id="trackListBackButton" />
                <Label height="60" width="460" translation="[30,480]"
                       wrap="true"
                       font="font:SmallSystemFont"
                       color="#AAAAAA"
                       id="trackListStatusLabel" />
            </Rectangle>
        </Rectangle>

        <!-- ============================================================= -->
        <!-- P3-S4 Sleep Timer panel. Hidden by default; opened by the     -->
        <!-- Sleep button in the bottom bar. Shows preset durations       -->
        <!-- (15/30/45/60/90/120 min) plus Cancel. Additive: the default   -->
        <!-- playback path is byte-unchanged when never opened.           -->
        <!-- ============================================================= -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.4" visible="false" id="sleepTimerPanel">
            <Rectangle height="480" width="520" translation="[40,120]" color="#0d0d1a">
                <Label height="50" width="460" translation="[30,20]"
                       text="Sleep Timer"
                       font="font:LargeBoldSystemFont"
                       color="#FFFFFF" />
                <LabelList height="340" width="460" translation="[30,90]"
                           id="sleepTimerPresetList" />
                <Button height="60" width="200" translation="[30,400]"
                        title="Cancel"
                        id="sleepTimerCancelButton" />
                <Label height="70" width="460" translation="[30,440]"
                       wrap="true"
                       font="font:SmallSystemFont"
                       color="#AAAAAA"
                       id="sleepTimerStatusLabel" />
            </Rectangle>
        </Rectangle>

        <!-- ============================================================= -->
        <!-- P3-S4 PiP (Picture-in-Picture) snapshot overlay.              -->
        <!-- Hidden by default; shown when user activates PiP mode.        -->
        <!-- Displays a scaled snapshot of the video in the corner.       -->
        <!-- Additive: default playback path is byte-unchanged.            -->
        <!-- ============================================================= -->
        <!-- PiP snapshot image node -->
        <Rectangle height="200" width="340" translation="[920,500]"
                   color="#000000"
                   visible="false"
                   id="pipSnapshotContainer">
            <Poster height="190" width="330" translation="[5,5]" id="pipSnapshotImage"
                    loadWidth="330" loadHeight="190" loadDisplayMode="scaleToFit" />
            <Button height="40" width="80" translation="[5,5]"
                    title="Exit"
                    id="pipExitButton" />
        </Rectangle>

        <!-- ============================================================= -->
        <!-- P5-S5 Access/Stream limit error overlay.                       -->
        <!-- Shown when server returns 403 AccessSchedule or 429          -->
        <!-- StreamLimitExceeded. Pauses playback and displays the error   -->
        <!-- with an OK button to return to browse/home.                   -->
        <!-- ============================================================= -->
        <Rectangle height="720" width="1280" color="#000000" transparency="0.6" visible="false" id="errorOverlay">
            <Rectangle height="320" width="520" translation="[380,200]" color="#1a1a2e">
                <Label height="60" width="460" translation="[30,30]"
                       text="Playback Error"
                       font="font:LargeBoldSystemFont"
                       color="#ff6b6b" />
                <Label height="120" width="460" translation="[30,100]"
                       wrap="true"
                       font="font:MediumSystemFont"
                       color="#FFFFFF"
                       id="errorMessageLabel" />
                <Button height="60" width="200" translation="[160,240]"
                        title="OK"
                        id="errorOkButton" />
            </Rectangle>
        </Rectangle>

        <!-- Up Next card (R7.2) -->
        <Rectangle height="300" width="500" translation="[390,240]"
                   color="#1a1a2e" opacity="0.95" visible="false"
                   id="upNextCard">
            <LayoutGroup layoutDirection="horiz" translation="[15,15]" vertAlignment="center">
                <Poster height="180" width="120" id="upNextCardPoster" />
                <LayoutGroup translation="[20,0]" vertAlignment="top">
                    <Label height="30" width="320" font="font:MediumBoldSystemFont"
                           color="#FFFFFF" id="upNextCardTitle" />
                    <Label height="20" width="320" font="font:SmallSystemFont"
                           color="#AAAAAA" text="Up Next in" id="upNextCardCountdown" />
                    <Button height="36" width="120" title="Play" translation="[0,10]"
                            id="upNextPlayButton" />
                    <Button height="36" width="120" title="Cancel" translation="[130,10]"
                            id="upNextCancelButton" />
                </LayoutGroup>
            </LayoutGroup>
        </Rectangle>
    </children>
</component>
