<component name="HomeScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <!-- [review roku__casualgamer MJ-4] the launch-failure toast rides the
         ambient-feedback layer; the lib is per-scope included (PlayerScene
         idiom), so HomeScene must declare it or GetToastManager is out of
         scope (BS1140). -->
    <script type="text/brightscript" uri="pkg:/source/lib/ToastManager.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="240" translation="[64,36]"
                   text="Phlix"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
            <!-- M-ROKU-30 (review roku__gameux): the row used to run off the
                 canvas - adminButton sat at x=1240 with w=180, ending 140px
                 past the 1280 edge (visible only for admins, so the overflow
                 hid behind the isAdmin gate). Repacked inside 1280; the
                 x-ORDER and names are untouched (CHECK29 walks edges by
                 x-order), heights/gap rhythm kept.
                 MN-3 re-repack (review roku__casualgamer m3): the admin-only
                 Live TV hop gains its OWN revealed entry (tvButton, shipped
                 hidden exactly like adminButton), so the row carries seven
                 buttons. The old six shipped widths left no legal slot - the
                 row is repacked with the SAME rhythm: 10px gaps, one row,
                 every button still >=15px per title character, and the
                 rightmost edge now lands at 1265 (<= the 1280 plane CHECK64
                 R4 pins - five px tighter to the plane than admin's old
                 1260 edge, still clear of it). x-ORDER becomes
                 Search/For You/Favorites/Collections/Settings/Live TV/Admin -
                 the two admin-only entries ride the far end, non-admins
                 still stop at Settings. -->
            <Button height="60" width="130" translation="[250,36]"
                    title="Search"
                    id="searchButton" />
            <Button height="60" width="140" translation="[390,36]"
                    title="For You"
                    id="forYouButton" />
            <Button height="60" width="155" translation="[540,36]"
                    title="Favorites"
                    id="favoritesButton" />
            <Button height="60" width="175" translation="[705,36]"
                    title="Collections"
                    id="collectionsButton" />
            <Button height="60" width="120" translation="[890,36]"
                    title="Settings"
                    id="settingsButton" />
            <Button height="60" width="125" translation="[1020,36]"
                    title="Live TV"
                    visible="false"
                    id="tvButton" />
            <Button height="60" width="110" translation="[1155,36]"
                    title="Admin"
                    visible="false"
                    id="adminButton" />
        </Rectangle>
        <!-- Continue Watching rail (single row, hidden until populated) -->
        <Label height="36" width="1200" translation="[40,104]"
               text="Continue Watching"
               font="font:MediumBoldSystemFont"
               color="#FFFFFF"
               visible="false"
               id="continueLabel" />
        <PosterGrid height="300" width="1280" translation="[0,144]"
                    numColumns="5" numRows="1"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 280]"
                    visible="false"
                    id="continueGrid">
        </PosterGrid>

        <!-- Up Next rail (R7.2) — shares the Continue Watching slot (label
             [40,104] / grid [0,144]). The 720p home layout hosts exactly ONE
             top rail above the Libraries row; the old [40,448]/[0,488]
             placement stacked this rail byte-identically onto libraryLabel
             ([40,448]) and inside libraryGrid's footprint ([0,484]+200), and
             the vertical chain had no upnext arm — a ghost row no remote
             could reach [review roku__casualgamer M6]. Continue Watching
             wins the slot when it has items; Up Next only surfaces in the
             empty slot (both loaders enforce the exclusion in
             HomeScene.brs; scripts/verify-runtime.sh CHECK32 pins it). -->
        <Label height="36" width="1200" translation="[40,104]"
               text="Up Next"
               font="font:MediumBoldSystemFont"
               color="#FFFFFF"
               visible="false"
               id="upNextLabel" />
        <PosterGrid height="300" width="1280" translation="[0,144]"
                    numColumns="5" numRows="1"
                    itemSpacing="[20,15]"
                    basePosterSize="[220,280]"
                    visible="false"
                    id="upNextGrid">
        </PosterGrid>

        <!-- Libraries label -->
        <Label height="32" width="1200" translation="[64,448]"
               text="Libraries"
               font="font:MediumBoldSystemFont"
               color="#FFFFFF"
               id="libraryLabel" />
        <!-- Library Grid — MN-9: honest geometry. The description strip
             below used to sit at y=680 (8px of it off-canvas), so the
             grid's claimed 200 height ended below the strip top; the
             strip is now safe-area-flush at 636 and the grid abuts it.
             Row 2 was already clipped before this change (180px posters
             + 15px spacing in a 200px window); row 1 now clips 28px
             deeper — disclosed visible trade for reachable chrome. -->
        <PosterGrid height="152" width="1280" translation="[0,484]"
                    numColumns="5" numRows="2"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 180]"
                    id="libraryGrid">
        </PosterGrid>
        <!-- Description Area -->
        <Rectangle height="40" width="1280" translation="[0,636]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[64,8]"
                   text="Select a library"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="descriptionLabel" />
        </Rectangle>
        <!-- Loading Indicator — MN-10: the label now spans the plane so
             horizAlign="center" actually centers (an auto-width label
             rendered right-of-center from its x anchor), and it rides
             beside a Spinner: the repo's PlayerScene buffering idiom —
             visible drives the animation. -->
        <Label id="loadingLabel" text="Loading…"
               width="1280" translation="[0, 340]"
               horizAlign="center" color="#888888" visible="false" />
        <Spinner id="fetchSpinner" spinDuration="1" color="#FFFFFF"
                 translation="[624, 384]" visible="false" />
        <!-- M-ROKU-21 recovery control: hidden until a home rail read fails,
             then revealed + focused (the M16 boot-retry idiom, Check 47) so
             "the fetch failed" carries a pressable way back. It rides the right
             end of the description strip and never overlays populated grid
             content. ApplyXmlChrome overrides the title via
             Translate("common_retry"). -->
        <Button id="retryButton" translation="[1056,644]" width="160" height="36"
                title="Retry" focusable="true" visible="false" />
    </children>
</component>

