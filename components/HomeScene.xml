<component name="HomeScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="240" translation="[40,20]"
                   text="Phlix"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
            <Button height="60" width="180" translation="[300,20]"
                    title="Search"
                    id="searchButton" />
            <Button height="60" width="180" translation="[490,20]"
                    title="For You"
                    id="forYouButton" />
            <Button height="60" width="190" translation="[680,20]"
                    title="Favorites"
                    id="favoritesButton" />
            <Button height="60" width="220" translation="[880,20]"
                    title="Collections"
                    id="collectionsButton" />
            <Button height="60" width="180" translation="[1110,20]"
                    title="Admin"
                    visible="false"
                    id="adminButton" />
        </Rectangle>
        <!-- Continue Watching rail (single row, hidden until populated) -->
        <Label height="36" width="1200" translation="[40,104]"
               text="Continue Watching"
               font="font:MediumBoldSystemFont"
               color="#FFFFFF"
               visible="false"
               id="continueLabel" />
        <PosterGrid height="300" width="1280" translation="[0,144]"
                    numColumns="5" numRows="1"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 280]"
                    caption1Icon="handle://leftbottom"
                    visible="false"
                    id="continueGrid">
        </PosterGrid>

        <!-- Libraries label -->
        <Label height="32" width="1200" translation="[40,448]"
               text="Libraries"
               font="font:MediumBoldSystemFont"
               color="#FFFFFF"
               id="libraryLabel" />
        <!-- Library Grid -->
        <PosterGrid height="200" width="1280" translation="[0,484]"
                    numColumns="5" numRows="2"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 180]"
                    caption1Icon="handle://leftbottom"
                    id="libraryGrid">
        </PosterGrid>
        <!-- Description Area -->
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Select a library"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="descriptionLabel" />
        </Rectangle>
        <!-- Loading Indicator -->
        <Label id="loadingLabel" text="Loading..."
               translation="[640, 340]"
               horizAlign="center" color="#888888" visible="false" />
    </children>
</component>

