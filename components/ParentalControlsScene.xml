<!--
    ParentalControlsScene - P5-S5 Parental Controls
    Three sections: Schedules, Tags, Stream Limits
    Accessed from ProfileActionsScene via "Parental Controls" button.

    Route all data through a SINGLE observed ApiTask node (off the render thread).
    m.pendingOp guards against concurrent operations.
-->
<component name="ParentalControlsScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
        <function name="LoadProfile" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/ParentalControlsScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="1152" translation="[64,36]"
                   text="Parental Controls"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />
        </Rectangle>

        <!-- Section tabs: Schedules | Tags | Stream Limits -->
        <LayoutGroup translation="[40,120]" itemSpacings="[8]" layoutDirection="horizontal">
            <Button width="280" height="48" text="Schedules" id="tabSchedulesButton" />
            <Button width="280" height="48" text="Tags" id="tabTagsButton" />
            <Button width="280" height="48" text="Stream Limits" id="tabStreamLimitsButton" />
        </LayoutGroup>

        <!-- Schedules Section -->
        <LayoutGroup translation="[40,190]" itemSpacings="[10]" id="schedulesSection">
            <Label height="30" width="1200" text="Access Schedules"
            id="accessSchedulesLabel"
                   font="font:MediumBoldSystemFont" color="#FFFFFF" />

            <!-- List of existing schedules -->
            <LabelList height="200" width="1200" id="schedulesList" />

            <!-- Add new schedule form. [review roku__gameux CR-2] TextFormDialog
                 is not a Roku node type and is not defined in this project (nor
                 are ToggleButton/HStack elsewhere) — on device these nodes fail
                 to instantiate and every `.text` read below silently sees
                 invalid, i.e. a form that cannot be typed into. Replaced with
                 the repo-proven Label + TextEditBox idiom (LoginScene); the
                 .brs contract (.text reads/writes) is unchanged. hintText
                 (not hint=) and secureMode (not secure=) are the real
                 TextEditBox attributes — the dead names silently never render
                 [reviews gameux CR-2 / MROKU-14/15]. -->
            <LayoutGroup itemSpacings="[8]" layoutDirection="horizontal">
                <Label id="scheduleNameLabel" text="Name:" height="36" width="80" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <TextEditBox id="scheduleNameInput" hintText="e.g. Weekday Bedtime" maxLength="80" width="320" />
            </LayoutGroup>

            <!-- Day-of-week checkboxes: Mon-Sun -->
            <LayoutGroup translation="[0,0]" itemSpacings="[12]" layoutDirection="horizontal">
                <Label id="daysLabel" height="48" width="80" text="Days:" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <Button width="100" height="48" text="Mon" id="dayMonButton" />
                <Button width="100" height="48" text="Tue" id="dayTueButton" />
                <Button width="100" height="48" text="Wed" id="dayWedButton" />
                <Button width="100" height="48" text="Thu" id="dayThuButton" />
                <Button width="100" height="48" text="Fri" id="dayFriButton" />
                <Button width="100" height="48" text="Sat" id="daySatButton" />
                <Button width="100" height="48" text="Sun" id="daySunButton" />
            </LayoutGroup>

            <!-- Time pickers (using text input for HH:MM format) -->
            <LayoutGroup itemSpacings="[8]" layoutDirection="horizontal">
                <Label id="startTimeLabel" text="Start:" height="36" width="80" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <TextEditBox id="startTimeInput" hintText="HH:MM" maxLength="5" width="130" />
                <Label id="endTimeLabel" text="End:" height="36" width="60" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <TextEditBox id="endTimeInput" hintText="HH:MM" maxLength="5" width="130" />
            </LayoutGroup>

            <!-- Add schedule button -->
            <LayoutGroup itemSpacings="[8]" layoutDirection="horizontal">
                <Button width="300" height="48" text="Add Schedule" id="addScheduleButton" />
                <Button width="300" height="48" text="Delete Selected" id="deleteScheduleButton" />
            </LayoutGroup>
        </LayoutGroup>

        <!-- Tags Section -->
        <LayoutGroup translation="[40,190]" itemSpacings="[10]" id="tagsSection">
            <Label height="30" width="1200" text="Blocked Tags"
            id="blockedTagsLabel"
                   font="font:MediumBoldSystemFont" color="#FFFFFF" />

            <!-- List of existing tags -->
            <LabelList height="280" width="1200" id="tagsList" />

            <!-- Add new tag form -->
            <LayoutGroup itemSpacings="[8]" layoutDirection="horizontal">
                <Label id="tagNameLabel" text="Tag:" height="36" width="60" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <TextEditBox id="tagNameInput" hintText="e.g. restricted" maxLength="64" width="300" />
                <Button width="200" height="48" text="Add Blocked Tag" id="addTagButton" />
                <Button width="200" height="48" text="Remove Selected" id="removeTagButton" />
            </LayoutGroup>
        </LayoutGroup>

        <!-- Stream Limits Section -->
        <LayoutGroup translation="[40,190]" itemSpacings="[10]" id="streamLimitsSection">
            <Label height="30" width="1200" text="Concurrent Stream Limits"
            id="streamLimitsLabel"
                   font="font:MediumBoldSystemFont" color="#FFFFFF" />

            <!-- Current limit display -->
            <Label height="40" width="1200" text="" font="font:MediumSystemFont"
                   color="#FFFFFF" id="currentStreamLimitLabel" />

            <!-- Max concurrent streams input -->
            <LayoutGroup itemSpacings="[8]" layoutDirection="horizontal">
                <Label id="maxStreamsLabel" text="Max Streams:" height="36" width="130" font="font:MediumSystemFont" color="#AAAAAA" vertAlign="center" />
                <TextEditBox id="maxStreamsInput" hintText="1-10" maxLength="2" width="90" />
                <Button width="200" height="48" text="Update Limit" id="updateStreamLimitButton" />
            </LayoutGroup>
        </LayoutGroup>

        <!-- Status bar -->
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Loading…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
