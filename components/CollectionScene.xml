<component name="CollectionScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
        <function name="LoadCollection" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/CollectionScene.brs" />
    <children>
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Rectangle height="60" width="160" translation="[64,36]">
                <Button height="60" width="160" text="Back" id="backButton" />
            </Rectangle>
            <Label height="60" width="800" translation="[244,36]"
                   text="Collection"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />
        </Rectangle>
        <PosterGrid height="540" width="1280" translation="[0,100]"
                    numColumns="5" numRows="3"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 330]"
                    id="itemsGrid">
        </PosterGrid>
        <!-- Loading Indicator -->
        <Label id="loadingLabel" text="Loading…"
               translation="[640, 340]"
               horizAlign="center" color="#888888" visible="false" />
        <Rectangle height="40" width="1280" translation="[0,640]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Select an item"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="descriptionLabel" />
        </Rectangle>

        <!-- RT-094 [w15L9 R-B]: focusable retry shown by the browse
             failure arm (LoadCollection). The title literal is the en-fallback
             design-time value; ApplyXmlChrome re-localizes it through
             common_retry, the CHECK25 pairing. -->
        <Button id="retryButton" translation="[560,320]"
                width="160" height="36"
                text="Retry" focusable="true" visible="false" />
    </children>
</component>
