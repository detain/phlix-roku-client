<!-- R7.1: Settings scene with six sections:
     Account, Server, Playback, Captions, Watch History, About -->

<component name="SettingsScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/SettingsScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="800" translation="[40,20]"
                   text="Settings"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
        </Rectangle>

        <!-- Settings list (LabelList with section headers as items) -->
        <LabelList height="580" width="1200" translation="[40,120]"
                   id="settingsList"
                   itemSpacing="[0, 4]"
                   numRows="16" />

        <!-- Status bar -->
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text=""
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
