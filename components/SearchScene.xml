<component name="SearchScene" extends="Scene">
    <interface>
        <field id="requestClose" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/SearchScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="800" translation="[40,20]"
                   id="headerLabel"
                   text="Search"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
        </Rectangle>

        <!-- On-screen keyboard (left) -->
        <Keyboard height="540" width="600" translation="[40,120]"
                  maxLength="128"
                  id="keyboard" />

        <!-- Results grid (right) -->
        <PosterGrid height="540" width="600" translation="[660,120]"
                    numColumns="3" numRows="3"
                    itemSpacing="[20, 15]"
                    basePosterSize="[180, 270]"
                    id="resultsGrid">
        </PosterGrid>

        <!-- Status / empty hint -->
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Type to search…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>

        <!-- RT-094 [w15L9 R-B]: focusable retry shown by the browse
             failure arm (debounce re-arm). The title literal is the en-fallback
             design-time value; ApplyXmlChrome re-localizes it through
             common_retry, the CHECK25 pairing. -->
        <Button id="retryButton" translation="[1056,644]"
                width="160" height="36"
                text="Retry" focusable="true" visible="false" />
    </children>
</component>
