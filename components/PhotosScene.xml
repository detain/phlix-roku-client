<?xml version="1.0" encoding="utf-8"?>
<component name="PhotosScene" extends="Scene">
    <interface>
        <function name="LoadLibrary" />
    </interface>
    <!-- Transitive closure: a component scope does NOT auto-include pkg:/source.
         The .brs reaches Storage + Utilities + ApiClient + AppContext (via the
         ApiTask data path) plus its own controller. -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/PhotosScene.brs" />
    <children>
        <!-- Header -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="1200" translation="[40,20]"
                   text="Photos"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />
        </Rectangle>

        <!-- Album grid (date albums, cover thumbnails) -->
        <PosterGrid height="540" width="1280" translation="[0,100]"
                    numColumns="5" numRows="3"
                    itemSpacing="[20, 15]"
                    basePosterSize="[220, 220]"
                    caption1Icon="handle://leftbottom"
                    id="albumsGrid">
            <ContentEmitter />
        </PosterGrid>

        <!-- Status / empty hint -->
        <Rectangle height="40" width="1280" translation="[0,640]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Loading…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
