<!-- M-ROKU-04: one-shot SSDP LAN discovery task. UI-free by design: it only
     answers { servers: [origin, ...] } on `response`. Transitive closure: a
     component scope does NOT auto-include pkg:/source; Utilities.brs is the
     extract-boundary parser (ExtractServerOrigin) this task consumes. -->
<component name="DiscoveryTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" />
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/components/DiscoveryTask.brs" />
</component>
