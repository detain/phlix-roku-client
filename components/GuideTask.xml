<!-- components/GuideTask.xml -->

<!-- GuideTask — loads TV guide data off the render thread.
     Fetches guide via getGuide(), builds a ready-to-assign ContentNode
     with program captions — all on the task thread, not the render thread.

     Thread rule: this function runs on the task thread; it may ONLY read its own
     m.top fields and write m.top.content/programs/ok. -->
<component name="GuideTask" extends="Task">
    <interface>
        <!-- Built ContentNode with program rows (assign directly to labelList.content) -->
        <field id="content" type="node" alwaysNotify="true" />
        <!-- Raw programs array for scene to use in navigation -->
        <field id="programs" type="array" alwaysNotify="true" />
        <!-- Boolean success flag -->
        <field id="ok" type="boolean" alwaysNotify="true" />
    </interface>

    <!-- Transitive closure: Task scope does NOT auto-include pkg:/source.
         GetApiClient needs Storage + Utilities + ApiClient + AppContext.
         FormatUnixTime lives in Utilities. -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/GuideTask.brs" />
</component>