<!-- components/ChannelListTask.xml -->

<!-- ChannelListTask — loads live-TV channel list off the render thread.
     Fetches channels via getChannels(), builds a ready-to-assign ContentNode
     with channel captions — all on the task thread, not the render thread.

     Thread rule: this function runs on the task thread; it may ONLY read its own
     m.top fields and write m.top.content/channels/ok. -->
<component name="ChannelListTask" extends="Task">
    <interface>
        <!-- Built ContentNode with channel rows (assign directly to labelList.content) -->
        <field id="content" type="node" alwaysNotify="true" />
        <!-- Raw channels array for scene to use in navigation -->
        <field id="channels" type="stringarray" alwaysNotify="true" />
        <!-- Boolean success flag -->
        <field id="ok" type="boolean" alwaysNotify="true" />
    </interface>

    <!-- Transitive closure: Task scope does NOT auto-include pkg:/source.
         GetApiClient needs Storage + Utilities + ApiClient + AppContext.
         ChannelRowCaption lives in LiveTvScene (scene will read it from
         the task result, not call it across the thread boundary). -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/ChannelListTask.brs" />
</component>