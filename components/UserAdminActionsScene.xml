<?xml version="1.0" encoding="utf-8"?>
<component name="UserAdminActionsScene" extends="Scene">
    <!-- UserAdminScene calls scene.LoadUser(...) across the component boundary,
         so the LoadUser interface fn MUST be declared (bsc does NOT catch a
         missing one - it is a runtime failure). Transitive closure: a component
         scope does NOT auto-include pkg:/source. -->
    <interface>
        <function name="LoadUser" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/UserAdminActionsScene.brs" />
    <children>
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="1200" translation="[40,20]"
                   text="User"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF"
                   id="titleLabel" />
        </Rectangle>
        <!-- Vertical action button column -->
        <LayoutGroup translation="[40,160]" itemSpacings="[20]">
            <Button width="420" height="64" title="Approve" id="approveButton" />
            <Button width="420" height="64" title="Disable" id="disableButton" />
            <Button width="420" height="64" title="Set Admin" id="adminButton" />
            <Button width="420" height="64" title="Reset Password" id="resetPasswordButton" />
            <Button width="420" height="64" title="Refresh" id="refreshButton" />
        </LayoutGroup>
        <!-- Current user-state detail -->
        <Label width="1200" height="240" translation="[500,160]"
               text=""
               wrap="true"
               font="font:MediumSystemFont"
               color="#FFFFFF"
               id="detailLabel" />
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Loading…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>
