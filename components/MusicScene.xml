<component name="MusicScene" extends="Scene">
    <!-- HomeScene self-creates + appends + focuses this scene, so NO interface
         function is required. Transitive closure: a component scope does NOT
         auto-include pkg:/source. -->
    <script type="text/brightscript" uri="pkg:/source/lib/Storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/Utilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/ApiClient.brs" />
    <script type="text/brightscript" uri="pkg:/source/lib/AppContext.brs" />
    <script type="text/brightscript" uri="pkg:/components/MusicScene.brs" />
    <children>
        <!-- Header: title + three mode buttons -->
        <Rectangle height="100" width="1280" color="#1a1a2e">
            <Label height="60" width="240" translation="[40,20]"
                   text="Music"
                   font="font:LargeBoldSystemFont"
                   color="#FFFFFF" />
            <Button height="60" width="200" translation="[320,20]"
                    title="Artists"
                    id="artistsButton" />
            <Button height="60" width="200" translation="[560,20]"
                    title="Albums"
                    id="albumsButton" />
            <Button height="60" width="200" translation="[800,20]"
                    title="Tracks"
                    id="tracksButton" />
        </Rectangle>

        <!-- Full-width text list (music has no artwork) -->
        <LabelList height="500" width="1200" translation="[40,140]"
                   id="musicList" />

        <!-- Status / empty hint -->
        <Rectangle height="40" width="1280" translation="[0,680]" color="#0d0d1a">
            <Label height="40" width="1200" translation="[40,8]"
                   text="Loading…"
                   font="font:MediumSystemFont"
                   color="#AAAAAA"
                   id="statusLabel" />
        </Rectangle>
    </children>
</component>