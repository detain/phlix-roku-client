__pycache__/

# brighterscript (bsc) gate install artifacts - this is a Roku (zip) repo, not a
# Node project; bsconfig.json/package.json are tracked but the install output is not.
node_modules/

# Local packaging output (review M-ROKU-31): `make package`/`make dev-package`
# write build/, and the signed/dev zip lands at repo root with its sha256
# sibling. Standing local artifacts - CI rebuilds and never consumes committed
# ones; ignoring them keeps `git status` honest instead of permanently dirty.
build/
phlix.zip
phlix.zip.sha256

# Session-learned Claude skills (the tracked find-skills/save-learning/setup-caliber
# skills stay; only save-learning's generated learned-* outputs are excluded).
.claude/skills/learned-*/
